generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  staff
  customer
}

enum CouponType {
  percent
  fixed
}

enum OrderStatus {
  pending
  confirmed
  cancelled
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(customer)
  favorites    Product[] @relation("UserFavorites")
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  price       Float
  category    String      @default("fruta")
  available   Boolean     @default(true)
  imageUrl    String?
  stock       Int         @default(0)
  description String?
  favoritedBy User[]      @relation("UserFavorites")
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([name])
}

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType
  amount    Float
  minTotal  Float      @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  maxUses   Int?
  usedCount Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  customerId    String
  customer      User        @relation(fields: [customerId], references: [id])
  customerName  String
  customerPhone String
  date          String
  status        OrderStatus @default(pending)
  items         OrderItem[]
  total         Float
  couponCode    String?
  discount      Float       @default(0)
  finalTotal    Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  qty       Int
  unitPrice Float

  @@index([orderId])
  @@index([productId])
}
